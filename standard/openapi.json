    "/Mosaic-api/models/{modelId}/versions/{versionId}": {
      "get": {
        "operationId": "ModelVersionRoutes_get_model_version",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/uuid"
            }
          },
          {
            "name": "versionId",
            "in": "path",
            "required": true,
