          "putURL": {
            "type": "string"
          }
        }
      },
      "CreateTesseraCommand": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "CreateTesseraVersionCommand": {
        "type": "object",
        "required": [
          "id",
          "previousTesseraVersionId",
          "blobId"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "previousTesseraVersionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "blobId": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      },
      "CreateTesseraVersionResponse": {
        "type": "object",
        "required": [
          "state",
          "validationErrors"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CreateTesseraVersionResponseState"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateTesseraVersionResponseState": {
        "type": "string",
        "enum": [
          "OK",
          "OUT_OF_DATE",
          "VALIDATION_ERROR"
        ]
      },
      "MosaicFileDownloadType": {
        "type": "string",
        "enum": [
          "just_this_version",
          "whole_tessera_history_intact",
          "whole_tessera_history_condensed",
          "whole_tessera_and_imports_history_condensed"
        ]
      },
      "MosaicProvenanceData": {
        "type": "object",
        "required": [
          "author",
          "timestamp",
          "application",
          "message"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "application": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MosaicQueryApiNodeComponent": {
        "type": "object",
        "required": [
          "name",
          "type",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {}
        }
      },
      "MosaicQueryApiNodeResponse": {
        "type": "object",
        "required": [
          "components"
        ],
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MosaicQueryApiNodeComponent"
            }
          }
        }
      },
      "MosaicQueryApiResponse": {
        "type": "object",
        "required": [
          "nodes"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MosaicQueryApiNodeResponse"
            }
          }
        }
      },
      "NodeFetchFormat": {
        "type": "string",
        "enum": [
          "glb",
          "tsr"
        ]
      },
      "NodeFetchRequest": {
        "type": "object",
        "required": [
          "nodes"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/uuid"
            }
          },
          "componentTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includeChildren": {
            "type": "boolean"
          },
          "compose": {
            "type": "boolean"
          }
        }
      },
      "TesseraDetails": {
        "type": "object",
        "required": [
          "id",
          "name",
          "history"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "name": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TesseraVersion"
            }
          }
        }
      },
      "TesseraStatus": {
        "type": "object",
        "required": [
          "id",
          "name",
          "latestVersion"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "name": {
            "type": "string"
          },
          "latestVersion": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      },
      "TesseraVersion": {
        "type": "object",
        "required": [
          "tesseraId",
          "versionId",
          "previousVersionId",
          "provenance"
        ],
        "properties": {
          "tesseraId": {
            "$ref": "#/components/schemas/uuid"
          },
          "versionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "previousVersionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "provenance": {
            "$ref": "#/components/schemas/MosaicProvenanceData"
          }
        }
      },
      "TesseraVersionMosaicFile": {
        "type": "object",
        "required": [
          "blobUrl"
        ],
        "properties": {
          "blobUrl": {
            "type": "string"
          }
        }
      },
      "uuid": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
