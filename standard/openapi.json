  "components": {
    "schemas": {
      "BlobResponse": {
        "type": "object",
        "required": [
          "blobId",
          "putURL"
        ],
        "properties": {
          "blobId": {
            "$ref": "#/components/schemas/uuid"
          },
          "putURL": {
            "type": "string"
          }
        }
      },
      "CreateModelCommand": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "CreateModelVersionCommand": {
        "type": "object",
        "required": [
          "id",
          "previousModelVersionId",
          "blobId"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "previousModelVersionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "blobId": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      },
      "CreateModelVersionResponse": {
        "type": "object",
        "required": [
          "state",
          "validationErrors"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CreateModelVersionResponseState"
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateModelVersionResponseState": {
        "type": "string",
        "enum": [
          "OK",
          "OUT_OF_DATE",
          "VALIDATION_ERROR"
        ]
      },
      "ModelDetails": {
        "type": "object",
        "required": [
          "id",
          "name",
          "history"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "name": {
            "type": "string"
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelVersion"
            }
          }
        }
      },
      "ModelStatus": {
        "type": "object",
        "required": [
          "id",
          "name",
          "latestVersion"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/uuid"
          },
          "name": {
            "type": "string"
          },
          "latestVersion": {
            "$ref": "#/components/schemas/uuid"
          }
        }
      },
      "ModelVersion": {
        "type": "object",
        "required": [
          "modelId",
          "versionId",
          "previousVersionId",
          "provenance"
        ],
        "properties": {
          "modelId": {
            "$ref": "#/components/schemas/uuid"
          },
          "versionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "previousVersionId": {
            "$ref": "#/components/schemas/uuid"
          },
          "provenance": {
            "$ref": "#/components/schemas/MosaicProvenanceData"
          }
        }
      },
      "ModelVersionMosaicFile": {
        "type": "object",
        "required": [
          "blobUrl"
        ],
        "properties": {
          "blobUrl": {
            "type": "string"
          }
        }
      },
      "MosaicFileDownloadType": {
        "type": "string",
        "enum": [
          "just_this_version",
          "whole_model_history_intact",
          "whole_model_history_condensed",
          "whole_model_and_imports_history_condensed"
        ]
      },
      "MosaicProvenanceData": {
        "type": "object",
        "required": [
          "author",
          "timestamp",
          "application",
          "message"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "application": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MosaicQueryApiNodeComponent": {
        "type": "object",
        "required": [
          "name",
          "type",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {}
        }
      },
      "MosaicQueryApiNodeResponse": {
        "type": "object",
        "required": [
          "components"
        ],
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MosaicQueryApiNodeComponent"
            }
          }
        }
      },
      "MosaicQueryApiResponse": {
        "type": "object",
        "required": [
          "nodes"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MosaicQueryApiNodeResponse"
            }
          }
        }
      },
