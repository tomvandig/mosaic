{
  "name": "mosaic-ts",
  "version": "0.1.0",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./duckdb": "./src/duckdb/index.ts",
    "./api": "./src/api/index.ts"
  },
  "scripts": {
    "test": "node --experimental-transform-types --test \"test/**/*.test.ts\"",
    "test:watch": "node --experimental-transform-types --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.viewer.json",
    "example:duckdb": "node --experimental-transform-types examples/duckdb-queries.ts",
    "build:viewer": "node scripts/build-viewer.mjs",
    "build:examples": "node --experimental-transform-types scripts/build-examples.mjs",
    "build:static": "npm run build:viewer && npm run build:examples"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0"
  }
}
