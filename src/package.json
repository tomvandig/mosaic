{
  "name": "mosaic-schema",
  "version": "0.1.0",
  "devDependencies": {
    "@typespec/compiler": "^1.9.0",
    "@typespec/json-schema": "^1.9.0",
    "@typespec/openapi3": "^1.9.0",
    "quicktype": "^23.2.6"
  },
  "scripts": {
    "compile-json-spec": "tsp compile mosaic-json-file.tsp && node scripts/name-schema.mjs",
    "gen-sdk-index-ts": "quicktype -s schema ../standard/mosaic-index-file.schema.json -l ts -o ../sdk/ts/src/MosaicIndexFile.ts",
    "compile-api-spec": "tsp compile mosaic-api.tsp --config ./tspconfig.api.yaml",
    "gen-api-sdk": "node scripts/gen-api-sdk.mjs"
  },
  "private": true
}
